"""SCons file for building standalone C host executables in DLL mode tests."""

import os
import sys
import types

sys.modules["nuitka"] = types.ModuleType("nuitka")
sys.modules["nuitka"].__path__ = [os.environ["NUITKA_PACKAGE_DIR"]]

import nuitka.build  # pylint: disable=unused-import

__package__ = "nuitka.build"  # pylint: disable=redefined-builtin

# isort:start

from nuitka.build.SconsCompilerSettings import (
    createNuitkaSconsEnvironment,
    reportCCompiler,
    setupCCompiler,
)
from nuitka.build.SconsControl import executeSconsBuild
from nuitka.build.SconsSourceIndex import getSourceFilenamesFromIndex
from nuitka.build.SconsUtils import (
    getArgumentRequired,
    makeResultPathFileSystemEncodable,
)
from nuitka.Tracing import scons_logger

env = createNuitkaSconsEnvironment()
env.low_memory = False
env.debug_mode = False
env.debugger_mode = False
env.unstripped_mode = False
env.console_mode = "force"
env.resource_mode = "absent"
env.dll_mode = False
env.module_mode = False

result_exe = getArgumentRequired("result_exe")
header_dir = getArgumentRequired("header_dir")

reportCCompiler(env, "Host", scons_logger.info)

setupCCompiler(
    env=env,
    pgo_mode="no",
    exe_target=True,
    onefile_compile=False,
)

env.Append(CPPPATH=[header_dir])

if env.target_os == "Linux":
    env.Append(LIBS=["dl", "pthread"])
elif "BSD" in env.target_os:
    env.Append(LIBS=["pthread"])

source_filenames = getSourceFilenamesFromIndex(env=env, source_dir=env.source_dir)
result_exe = makeResultPathFileSystemEncodable(env=env, result_exe=result_exe)

# MSYS2 Python paths need native normalization inside SCons.
target = env.Program(os.path.normpath(result_exe), source_filenames)

executeSconsBuild(
    env=env,
    target=target,
    source_filenames=source_filenames,
    progressbar_name="Host",
    stable_include_paths=False,
)

