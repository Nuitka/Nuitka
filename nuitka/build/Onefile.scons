"""Onefile SCons file for building the bootstrap binary."""

# Make nuitka package importable from calling installation

import os
import sys
import types

sys.modules["nuitka"] = types.ModuleType("nuitka")
sys.modules["nuitka"].__path__ = [os.environ["NUITKA_PACKAGE_DIR"]]

import nuitka.build  # pylint: disable=unused-import

__package__ = "nuitka.build"  # pylint: disable=redefined-builtin

# isort:start

from nuitka.Tracing import scons_logger
from nuitka.utils.FileOperations import getExternalUsePath
from nuitka.utils.InlineCopies import getInlineCopyFolderIfExists

from .SconsCompilerSettings import (
    createNuitkaSconsEnvironment,
    reportCCompiler,
    setupCCompiler,
)
from .SconsControl import executeSconsBuild
from .SconsSourceIndex import getSourceFilenamesFromIndex
from .SconsUtils import (
    createDefinitionsFile,
    getArgumentBool,
    getArgumentDefaulted,
    getArgumentRequired,
    linkSystemLibrary,
    makeResultPathFileSystemEncodable,
)

# spell-checker: ignore cppdefines,cpppath

env = createNuitkaSconsEnvironment()
assert env.low_memory is False

static_src = os.path.join(env.source_dir, "static")

result_exe = getArgumentDefaulted("result_exe", None)

module_mode = getArgumentBool("module_mode", False)
env.module_mode = module_mode
# TODO: Stop passing dll_mode=true from common SCons options to Onefile.scons.
env.dll_mode = False

debug_mode = env.debug_mode
target_arch = env.target_arch

python_prefix = getArgumentRequired("python_prefix")
python_prefix_external = getExternalUsePath(python_prefix)

onefile_splash_screen = getArgumentBool("onefile_splash_screen", False)
onefile_compression = getArgumentBool("onefile_compression", False)

reportCCompiler(env, "Onefile", output_func=scons_logger.info)

setupCCompiler(
    env=env,
    pgo_mode="no",
    exe_target=True,
    onefile_compile=True,
)

if debug_mode:
    env.Append(CPPDEFINES=["_NUITKA_DEBUG"])

if env.trace_mode:
    env.Append(CPPDEFINES=["_NUITKA_TRACE"])

nuitka_include = os.path.join(env.nuitka_src, "include")

if not os.path.exists(os.path.join(nuitka_include, "nuitka", "prelude.h")):
    sys.exit(
        "Error, cannot locate Nuitka includes at '%s', broken installation."
        % nuitka_include
    )

env.Append(
    CPPPATH=[
        env.source_dir,
        nuitka_include,
        os.path.join(env.nuitka_src, "static_src"),
    ],
)

# Downstream packages (e.g. Debian) strip the inline copy of zstd and link the
# system library instead.
if onefile_compression:
    zstd_inline_copy_dir = getInlineCopyFolderIfExists("zstd")

    if zstd_inline_copy_dir is not None:
        env.Append(CPPPATH=[zstd_inline_copy_dir])
    else:
        env.Append(CPPDEFINES=["_NUITKA_USE_SYSTEM_ZSTD"])

        linkSystemLibrary(env=env, library_name="zstd")

env.Append(CPPDEFINES=["_NUITKA_EXE_MODE"])

source_filenames = getSourceFilenamesFromIndex(env=env, source_dir=env.source_dir)
result_exe = makeResultPathFileSystemEncodable(env=env, result_exe=result_exe)

# For scons internal use, we use Python native paths as MSYS2 does wrong things otherwise.
target = env.Program(os.path.normpath(result_exe), source_filenames)

if os.path.exists(target[0].abspath):
    os.unlink(target[0].abspath)


def createBuildDefinitionsFile():
    onefile_definitions = {}

    # TODO: Do this via a plugin too, so it can provide these externally.
    if onefile_splash_screen:
        onefile_definitions["_NUITKA_ONEFILE_SPLASH_SCREEN"] = 1

        # spell-checker: ignore Windowscodecs
        env.Append(LIBS=["Ole32", "Windowscodecs", "User32", "Gdi32"])

    onefile_definitions["_NUITKA_ONEFILE_COMPRESSION_BOOL"] = (
        1 if onefile_compression else 0
    )

    if env.onefile_dll_mode:
        # Zig cannot strip the export name, so the ordinal is absent there and
        # the bootstrap looks 'run_code' up by name.
        if not env.zig_mode:
            onefile_definitions["_NUITKA_ONEFILE_DLL_RUN_CODE_ORDINAL_INT"] = 1

        if os.name == "nt":
            env.Append(LIBS=["PsApi"])

    createDefinitionsFile(env.source_dir, "onefile_definitions.h", onefile_definitions)


createBuildDefinitionsFile()

executeSconsBuild(
    env=env,
    target=target,
    source_filenames=source_filenames,
    progressbar_name="Onefile",
    stable_include_paths=True,
)

