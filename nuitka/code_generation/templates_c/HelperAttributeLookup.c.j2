static PyObject *{{ helper_name }}(PyThreadState *tstate, PyObject *source) {
#if PYTHON_VERSION >= 0x3b0 && !defined(Py_GIL_DISABLED)
    static Nuitka_AttributeCache cache = {0, 0};

    PyObject *hit = Nuitka_AttributeCache_Get(&cache, source);

    if (likely(hit != NULL)) {
        return hit;
    }

    PyObject *result = LOOKUP_ATTRIBUTE(tstate, source, {{ attribute_name_code }});

    if (result != NULL && cache.type_ver == 0) {
        Nuitka_AttributeCache_Fill(&cache, source, {{ attribute_name_code }}, result);
    }

    return result;
#else
    return LOOKUP_ATTRIBUTE(tstate, source, {{ attribute_name_code }});
#endif
}

