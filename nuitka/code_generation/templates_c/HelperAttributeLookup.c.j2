{{ result_type }} {{ helper_name }}(PyThreadState *tstate, PyObject *source{% if not slot_name %}, PyObject *attr_name{% endif %}) {
{% if slot_name %}
    CHECK_OBJECT(source);

{% elif result_kind != "object" %}
    CHECK_OBJECT(source);
    CHECK_OBJECT(attr_name);

{% endif %}
#if _NUITKA_EXPERIMENTAL_DISABLE_ATTR_OPT
{% if result_kind == "object" %}
    return PyObject_GetAttr(source, {{ attr_name }});
{% elif result_kind == "bool" %}
    return PyObject_HasAttr(source, {{ attr_name }});
{% else %}
    PyObject *result = PyObject_GetAttr(source, {{ attr_name }});

    if (result == NULL) {
        if (CHECK_AND_CLEAR_ATTRIBUTE_ERROR_OCCURRED(tstate) == false) {
            return -1;
        }

        return 0;
    }

    Py_DECREF(result);
    return 1;
{% endif %}
#else
{% if result_kind == "object" and not slot_name %}
    CHECK_OBJECT(source);
    CHECK_OBJECT(attr_name);

{% endif %}
    {{ attribute_lookup_core(attr_name, slot_name, result_kind) }}
#endif
}

