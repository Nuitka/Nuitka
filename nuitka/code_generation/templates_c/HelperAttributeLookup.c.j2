            }
        }

        PyObject *dict = NULL;

        Py_ssize_t dict_offset = type->tp_dictoffset;

#if PYTHON_VERSION >= 0x3b0
        if (type->tp_flags & Py_TPFLAGS_MANAGED_DICT) {
