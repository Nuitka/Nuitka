{% macro lookup_result(result_kind) %}
    CHECK_OBJECT(result);
{% if result_kind != "object" %}
    Py_DECREF(result);
{% endif %}
    return {{ "result" if result_kind == "object" else "true" if result_kind == "bool" else "1" }};
{%- endmacro %}

{% macro missing_attribute(attr_name, slot_name, result_kind) %}
{% if result_kind == "object" %}
{% if slot_name %}
    PyErr_Format(PyExc_AttributeError, "'%s' object has no attribute '{{ slot_name }}'", type->tp_name);
{% else %}
#if PYTHON_VERSION < 0x300
    PyErr_Format(PyExc_AttributeError, "'%s' object has no attribute '%s'", type->tp_name,
                 PyString_AS_STRING({{ attr_name }}));
#else
    PyErr_Format(PyExc_AttributeError, "'%s' object has no attribute '%U'", type->tp_name, {{ attr_name }});
#endif
{% endif %}
#if PYTHON_VERSION >= 0x3a0
    SET_ATTRIBUTE_ERROR_CONTEXT(tstate, source, {{ attr_name }});
#endif
{% endif %}
    return {{ "NULL" if result_kind == "object" else "false" if result_kind == "bool" else "0" }};
{%- endmacro %}

